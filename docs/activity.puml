@startuml
skinparam defaultFontName Segoe UI
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #555555
skinparam ArrowColor #555555
title Local harness - task plan (ai-task-tracker)

start
partition "T-001 P-00 feature planning (DONE)" {
  :Done (CP-1 + CP-F approved); <<#90EE90>>
}
partition "T-002 A-01 requirements analysis (DONE)" {
  :FR/NFR R-NNN, questions resolved (defaults), glossary; <<#90EE90>>
}
partition "T-003 A-02 e2e use cases and dataset (DONE)" {
  :use cases UC-E2E-NNN + YAML dataset; <<#90EE90>>
}
partition "T-004 U-01 UX flows and screens (AWAITING REVIEW)" {
  :personas, journeys, IA, screen inventory, screen states (T-005..T-012 pending, see docs/plan.md); <<#87CEFA>>
}
stop

legend right
 |= Color |= Status |
 |<#90EE90>| done |
 |<#FFE082>| in_progress |
 |<#87CEFA>| awaiting_review |
 |<#D3D3D3>| pending |
 |<#FF9090>| failed |
 |<#FFB347>| blocked |
endlegend
@enduml
