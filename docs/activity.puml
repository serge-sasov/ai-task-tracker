@startuml
skinparam defaultFontName Segoe UI
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #555555
skinparam ArrowColor #555555
title Local harness - task plan

start
:No tasks;
stop

legend right
|= Color |= Status |
|<#90EE90>| done |
|<#FFE082>| in_progress |
|<#87CEFA>| awaiting_review |
|<#D3D3D3>| pending |
|<#FF9090>| failed |
|<#FFB347>| blocked |
endlegend
@enduml
