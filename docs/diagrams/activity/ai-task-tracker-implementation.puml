  /harness-run -> board/deps -> in_progress -> delegate
  -> chunk loop (d2/d3) -> CHECKPOINT -> stage-done
  -> approved? resume : user review -> CP-F? done : fix/failed
  Детали:
  docs/diagrams/activity/ai-task-tracker-harness-subagent-loop.puml
end note

