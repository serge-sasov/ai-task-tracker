@startuml sequence-scn-003-ai-task-tracker
' T-007 R-02 — SCN-003: list + detail
' Trace: SCN-003 ↔ UC-E2E-003 | API: API-001
' Source: contracts §4.2 (list), §4.3 (detail)
autonumber
title SCN-003 — list + detail (UC-E2E-003)

actor "User" as user
participant "Vue SPA (S-01, S-02)" as spa
participant "api (Spring REST)" as api
participant "store (JPA / PG16)" as pg

user -> spa : open S-01 «Задачи»
spa -> api : GET /api/tasks?page=1&size=50 (API-001)
api -> pg : select tasks (filter from/to/status, page)
pg --> api : TASK-001..TASK-005
api --> spa : 200 {total:5, items:[{task_id,name,started_at,finished_at,status,duration_s,tokens_total}]}
note over spa : S-01 table; durations 9000/7200/8100/4200/2400 s; load < 3 s (R-023)
user -> spa : click TASK-001
spa -> api : GET /api/tasks/TASK-001 (API-001)
api -> pg : task + steps + solutions + token_usage
pg --> api : 6 steps (R-003), proposed[], chosen, by_model[]
api --> spa : 200 TaskDetailResponse
note over spa : S-02: steps chronological;\nsolutions «выбрано» label (not color only);\ntokens by model + total
user -> spa : open TASK-004 (no solutions)
spa -> api : GET /api/tasks/TASK-004
api --> spa : 200 {solutions:{proposed:[], chosen:null}}
note over spa : S-02 «Решений не зафиксировано»
user -> spa : open unknown id
spa -> api : GET /api/tasks/TASK-999
api --> spa : 404 {code:NOT_FOUND, message:«Задача не найдена.»}
@enduml
