{
  "name": "ai-task-tracker-web",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 SPA frontend for ai-task-tracker (RU UI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 80",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
