    "vue": "3.4.21",
    "vue-router": "4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.0.3",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^25.0.1",
    "typescript": "5.4.2",
    "vite": "5.2.6",
    "vitest": "^2.1.9",
    "vue-tsc": "2.0.7"
  }
}
