# Copy to .env and adjust for your machine.
# Docker compose auto-loads .env from the repository root.

# Host directory that contains the real opencode SQLite DB (opencode.db).
OPENCODE_DB_DIR=C:/Users/your-user/.local/share/opencode

# Host directory where the exporter writes per-session JSON files. The backend
# mounts the same directory as /data/opencode (read-only).
OPENCODE_DATA_DIR=./data/opencode-export
EXPORT_DIR=./data/opencode-export

# Cron-like periods (seconds).
EXPORT_INTERVAL_SECONDS=60
INGEST_INTERVAL_SECONDS=60

# Exporter bounds (latest top-level sessions; text parts per session).
EXPORT_LIMIT_SESSIONS=1000
EXPORT_MAX_PARTS=400
EXPORT_MAX_MESSAGES=50
EXPORT_MAX_TEXT=500

# Local Ollama (host) for AI search.
OLLAMA_BASE_URL=http://host.docker.internal:11434
API_OLLAMA_MODEL=qwen2.5:0.5b
