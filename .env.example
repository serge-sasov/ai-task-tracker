# Local development environment for the AI Task Tracker.
# Copy to .env for local docker compose usage. Values are placeholders only.

# Local opencode data directory, bind-mounted read-only into the backend.
OPENCODE_DATA_DIR=./data/opencode

# Local Ollama instance (embeddings + ranking).
OLLAMA_BASE_URL=http://localhost:11434

# Scheduled ingestion interval in seconds.
INGEST_INTERVAL_SECONDS=60

# AI search top-K candidate count (>= 5).
SEARCH_TOP_K=5

# PostgreSQL credentials (placeholders for local use only).
SPRING_DATASOURCE_USERNAME=aitasktracker
SPRING_DATASOURCE_PASSWORD=aitasktracker-local-change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aitasktracker

# Redis connection.
REDIS_HOST=localhost
REDIS_PORT=6379

# HTTP port the backend listens on.
SERVER_PORT=8080
